# PostgreSQL connection string.
# Get a free one from https://neon.tech, https://vercel.com/storage/postgres,
# or point this at a local Postgres instance.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Long random string used to sign admin session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Used ONLY by `npm run db:seed` to create the first admin account.
# Change the password after your first login if you like — there's no
# in-app "change password" screen yet, so update it by re-running the
# seed with a new ADMIN_PASSWORD, or directly in the database.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme123"
